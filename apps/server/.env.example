# Copy to apps/server/.env and fill in. Never commit the real file.
# Generate a secret with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

PORT=8080
HOST=0.0.0.0

# Signs guest device tokens. Required in production; a throwaway is generated at boot in
# development, which means tokens stop working across restarts.
AUTH_SECRET=

# How long a guest token stays valid.
TOKEN_TTL_MS=2592000000

# Rules timings. R-16 and R-18 fix the first two; changing them changes the game.
TURN_MS=30000
RECONNECT_GRACE_MS=45000

# Presentation and pacing. Not rules — see docs/DECISIONS.md.
REVEAL_MS=3500
BOT_THINK_MS=700

# Matchmaking: fill to MATCH_SIZE, or backfill with bots after this long in the queue.
MATCH_SIZE=4
QUEUE_BACKFILL_MS=10000

# Per-connection rate limit: burst size, then sustained messages per second.
RATE_LIMIT_BURST=20
RATE_LIMIT_PER_SECOND=5

LOG_LEVEL=info
